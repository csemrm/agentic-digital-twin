# Copy to .env and fill in. With no key set the system runs in deterministic mock mode.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 when blank.
LLM_MODEL=
# mock | real (defaults to mock when no key is set)
LLM_MODE=

# OpenAI instead of Anthropic: pip install -e '.[openai]', then set LLM_PROVIDER=openai.
# OPENAI_API_KEY alone does NOT switch providers, and LLM_MODE=mock keeps everything offline.
# LLM_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_MODEL=
