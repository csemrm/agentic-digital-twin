# Leave ANTHROPIC_API_KEY empty to run in deterministic mock mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# mock | real (defaults to mock when no key is set)
LLM_MODE=mock

# OpenAI instead of Anthropic: pip install -e '.[openai]', then set LLM_PROVIDER=openai.
# OPENAI_API_KEY alone does NOT switch providers, and LLM_MODE=mock above keeps everything offline.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
